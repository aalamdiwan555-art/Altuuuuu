    <LinearLayout
      xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:tools="http://schemas.android.com/tools"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:fitsSystemWindows="true"
      android:background="#F7F4EE">

      <LinearLayout
          android:id="@+id/subscription_status_bar"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:paddingStart="20dp"
          android:paddingTop="12dp"
          android:paddingEnd="20dp"
          android:paddingBottom="12dp"
          android:background="#E7F6EF"
          android:contentDescription="@string/subscription_status_content_description">

          <TextView
              android:id="@+id/subscription_status_title"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="@string/subscription_status_title"
              android:textColor="#1F363E"
              android:textSize="14sp"
              android:textStyle="bold" />

          <TextView
              android:id="@+id/subscription_status_value"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:gravity="end"
              android:text="@string/subscription_status_checking"
              android:textColor="#25775B"
              android:textSize="14sp"
              android:textStyle="bold" />
      </LinearLayout>

      <androidx.fragment.app.FragmentContainerView
          android:id="@+id/fragment"
          android:name="com.buzbuz.smartautoclicker.scenarios.list.ScenarioListFragment"
          android:tag="ScenarioList"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          tools:layout="@layout/fragment_scenarios" />
    </LinearLayout>
    